{
  "name": "@ryangarber/v10m",
  "description": "A versatile media downloader with built-in compression.",
  "version": "0.2.2",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev:cli": "node scripts/dev-cli.js",
    "dev:web": "node scripts/dev-web.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "build": "node scripts/build.js",
    "start:cli": "node dist/apps/cli/index.js",
    "start:web": "node dist/apps/web/index.js",
    "clean": "rm -rf ./dist"
  },
  "bin": {
    "v10m": "./dist/apps/cli/index.js",
    "v10m-web": "./dist/apps/web/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./jobs": "./dist/jobs/index.js",
    "./workers": "./dist/workers/index.js"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@types/toastify-js": "^1.12.4",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "esbuild": "^0.27.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fastify": "^5.6.2",
    "file-type": "^21.3.0",
    "kill-port": "^2.0.1",
    "sanitize-filename": "^1.6.3",
    "snowyflake": "^2.0.1",
    "toastify-js": "^1.12.0",
    "typescript-eslint": "^8.52.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/kill-port": "^2.0.3",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16"
  }
}
