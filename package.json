{
  "name": "@ryangarber/v10m",
  "description": "A versatile media downloader with built-in compression.",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "clean": "rm -rf ./dist",
    "prebuild": "npm run lint",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "dev:cli": "node --import tsx --watch --enable-source-maps src/apps/cli/index.ts",
    "dev:web": "node --import tsx --watch --enable-source-maps src/apps/web/index.ts",
    "start:cli": "node dist/apps/cli/index.js",
    "start:web": "node dist/apps/web/index.js",
    "test": "echo \"NYI\" && exit 0",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "v10m": "./dist/apps/cli/index.js",
    "v10m-web": "./dist/apps/web/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./jobs": "./dist/jobs/index.js",
    "./workers": "./dist/workers/index.js"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fastify": "^5.6.2",
    "file-type": "^21.3.0",
    "sanitize-filename": "^1.6.3",
    "snowyflake": "^2.0.1",
    "typescript-eslint": "^8.52.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0"
  }
}
