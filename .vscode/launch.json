{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Web",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "skipFiles": ["<node_internals>/*"],
      "console": "integratedTerminal",
      "env": {
        "V10M_DEBUG": "true"
      }
    },
    {
      "name": "Debug CLI",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:cli", "--", "${input:args}"],
      "skipFiles": ["<node_internals>/*"],
      "console": "integratedTerminal",
      "env": {
        "V10M_DEBUG": "true"
      }
    },
    {
      "name": "Debug File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx", "--watch", "--enable-source-maps"],
      "args": ["${file}"],
      "skipFiles": ["<node_internals>/*"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "V10M_DEBUG": "true"
      }
    }
  ]
}
