<!doctype html>
<html lang="en" data-mdb-theme="dark">
    <head>
        <title>v10m</title>
        <meta charset="UTF-8">
        <meta name="title" content="v10m" />
        <meta name="description" content="A versatile media downloader with built-in compression." />
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="v10m" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="<%= url %>" />
        <meta property="og:title" content="v10m" />
        <meta property="og:description" content="A versatile media downloader with built-in compression." />
        <meta property="og:image" content="<%= url %>/banner.png" />
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content="<%= url %>" />
        <meta property="twitter:title" content="v10m" />
        <meta property="twitter:description" content="A versatile media downloader with built-in compression." />
        <meta property="twitter:image" content="<%= url %>/banner.png" />
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/9.2.0/mdb.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.css" rel="stylesheet">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body>
        <div class="container my-5">
            <div class="subcontainer mx-auto" style="max-width: 600px">
                <div class="text-center mb-4">
                    <img src="<%= url %>/logo.png" alt="v10m" style="height: 100px;">
                </div>
                <div class="card" id="main">
                    <div class="card-body">
                        <ul class="nav nav-tabs w-100 border-bottom" role="tablist">
                            <% targetSizes.forEach((size, index) => { %>
                                <li class="nav-item flex-fill">
                                    <a class="nav-link py-3 <%= index === 0 ? 'active' : '' %>" href="#" data-size="<%= size %>"><%= size %>MB</a>
                                </li>
                            <% }); %>
                        </ul>
                        <div class="p-3" style="background: rgba(0, 0, 0, 0.1)">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Link to video" id="url">
                                <button class="btn btn-link" type="button" onclick="submit()">
                                    <i class="fas fa-xl fa-cloud-arrow-down"></i>
                                </button>
                            </div>
                            <div class="mt-4" style="display: none" id="status">
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%" id="progress"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mt-4" style="display: none" id="troubleshoot">
                    <div class="card-body">
                        <h5 class="card-title mb-0">Troubleshoot</h5>
                        <div class="mt-3">
                            <p class="text-muted small">Try including your cookies or login for the site.</p>
                            <div>
                                <label class="form-label small text-muted d-flex justify-content-between">
                                    <span>Netscape-Style Cookies</span>
                                    <span class="badge bg-primary">recommended</span>
                                </label>
                                <textarea class="form-control" placeholder="cookies.txt" id="cookies"></textarea>
                            </div>
                            <div class="mt-3">
                                <label class="form-label small text-muted d-flex justify-content-between">
                                    <span>Username & Password</span>
                                    <span class="badge bg-dark">not recommended</span>
                                </label>
                                <input type="text" class="form-control" placeholder="Username" id="username">
                                <input type="password" class="form-control" placeholder="Password" id="password">
                            </div>
                            <button class="btn btn-primary mt-3 w-100" onclick="save()">Try Again</button>
                        </div>
                    </div>
                </div>
                <div class="text-center text-muted small mt-4">
                    <%= version %>
                </div>
            </div>
        </div>

        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/9.2.0/mdb.umd.min.js"></script>
        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.js"></script>
        <script type="text/javascript" src="<%= url %>/v10m.js" async></script>
    </body>
</html>