<!DOCTYPE html>
<html lang="en" data-mdb-theme="dark">
  <head>
    <title>v10m</title>
    <meta charset="UTF-8" />
    <meta name="title" content="v10m" />
    <meta name="description" content="<%= description %>" />
    <link
      rel="icon"
      type="image/png"
      href="<%= url %>/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="<%= url %>/favicon.svg" />
    <link rel="shortcut icon" href="<%= url %>/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="<%= url %>/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="v10m" />
    <link rel="manifest" href="<%= url %>/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= url %>" />
    <meta property="og:title" content="v10m" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:image" content="<%= url %>/banner.png" />
    <meta property="og:logo" content="<%= url %>/logo.png" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="<%= url %>" />
    <meta property="twitter:title" content="v10m" />
    <meta property="twitter:description" content="<%= description %>" />
    <meta property="twitter:image" content="<%= url %>/banner.png" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/9.2.0/mdb.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.css"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <div class="container my-5">
      <div class="subcontainer mx-auto" style="max-width: 600px">
        <div class="text-center mb-4">
          <img src="<%= url %>/logo.png" alt="v10m" style="height: 75px" />
        </div>
        <div class="card" id="main">
          <div class="card-body">
            <ul class="nav nav-tabs w-100 border-bottom" role="tablist">
              <% targetSizes.forEach((size, index) => { %>
              <li class="nav-item flex-fill">
                <a
                  class="nav-link py-3 <%= index === 0 ? 'active' : '' %>"
                  href="#"
                  data-size="<%= size %>"
                  ><%= size %>MB</a
                >
              </li>
              <% }); %>
            </ul>
            <div class="p-3" style="background: rgba(0, 0, 0, 0.1)">
              <div class="input-group">
                <input
                  type="file"
                  class="form-control border-0"
                  id="file"
                  accept=".mp4,.mkv,.webm,.avi,.mov,.flv,.wmv"
                  onchange="submit('file')"
                />
              </div>
              <div class="d-flex my-1 align-items-center">
                <hr class="flex-grow-1" />
                <small class="d-block mx-2" style="color: #999">or</small>
                <hr class="flex-grow-1" />
              </div>
              <div class="input-group">
                <input
                  type="text"
                  class="form-control"
                  placeholder="link to video"
                  id="url"
                />
                <button class="btn btn-link" type="button" onclick="submit()">
                  get
                </button>
              </div>
              <div class="mt-4" style="display: none" id="status">
                <div class="progress">
                  <div
                    class="progress-bar progress-bar-striped progress-bar-animated"
                    style="width: 0%"
                    id="progress"
                  ></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="card mt-4" style="display: none" id="troubleshoot">
          <div class="card-body">
            <h5 class="card-title mb-0">Troubleshoot</h5>
            <div class="mt-3">
              <p class="text-muted small">
                Try including your cookies or login for the site.
              </p>
              <div>
                <label
                  class="form-label small text-muted d-flex justify-content-between"
                >
                  <span>Netscape-Style Cookies</span>
                  <span class="badge bg-primary">recommended</span>
                </label>
                <textarea
                  class="form-control"
                  placeholder="cookies.txt"
                  id="cookies"
                ></textarea>
              </div>
              <div class="mt-3">
                <label
                  class="form-label small text-muted d-flex justify-content-between"
                >
                  <span>Username & Password</span>
                  <span class="badge bg-dark">not recommended</span>
                </label>
                <input
                  type="text"
                  class="form-control"
                  placeholder="Username"
                  id="username"
                />
                <input
                  type="password"
                  class="form-control"
                  placeholder="Password"
                  id="password"
                />
              </div>
              <button class="btn btn-primary mt-3 w-100" onclick="save()">
                Try Again
              </button>
            </div>
          </div>
        </div>
        <div class="text-center text-muted small mt-4"><%= version %></div>
      </div>
    </div>
    <script>
      window.url = "<%= url %>";
    </script>
    <script
      type="text/javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/9.2.0/mdb.umd.min.js"
    ></script>
    <script
      type="text/javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.js"
    ></script>
    <script
      type="text/javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.11.0/axios.min.js"
    ></script>
    <script type="text/javascript" src="<%= url %>/app.js" async></script>
  </body>
</html>
